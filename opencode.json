{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/qwen/qwen3-coder:free",
  "small_model": "openrouter/z-ai/glm-4.5-air:free",
  "instructions": ["AGENTS.md", ".ai/HANDOFF.md"],
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}
